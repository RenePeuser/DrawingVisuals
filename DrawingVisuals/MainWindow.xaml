<Window x:Class="DrawingVisuals.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:drawingVisuals="clr-namespace:DrawingVisuals"
        Title="MainWindow" Height="350" Width="525">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="21*"/>
            <RowDefinition Height="139*"/>
        </Grid.RowDefinitions>
        <Button Width="50" Height="30" Content="Load" Margin="10,2,458.4,10.4" Click="Button_Click"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <drawingVisuals:MyVisualHost x:Name="drawingContainer1" Background="Yellow"  Margin="0" Grid.Row="1"/>
            <drawingVisuals:MyVisualHost x:Name="drawingContainer2" Background="Blue"  Margin="0" Grid.Row="1"/>
            <drawingVisuals:MyVisualHost x:Name="drawingContainer3" Background="Orange"  Margin="0" Grid.Row="1"/>
        </StackPanel>        
        <Button x:Name="clear"  Width="50" Height="30" Content="Clear&#xD;&#xA;" Margin="65,0,403.4,10.4" VerticalAlignment="Bottom" Click="clear_Click" />
    </Grid>
</Window>
